# Kopiere diese Datei zu ".env" und trage deine Schlüssel ein.

# Gehirn von JARVIS - EINEN der beiden Keys eintragen:
# Kostenlos: Google Gemini (https://aistudio.google.com -> "Get API key")
GEMINI_API_KEY=
# Kostenpflichtig, sehr stark: Claude (https://console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# Für die realistische Stimme (https://elevenlabs.io -> Profil -> API Keys)
ELEVENLABS_API_KEY=

# Stimme: Voice-ID aus der ElevenLabs Voice Library (Standard: "Daniel", tief und ruhig)
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# eleven_flash_v2_5 = am schnellsten (empfohlen), eleven_multilingual_v2 = etwas schöner, aber langsamer
ELEVENLABS_MODEL=eleven_flash_v2_5

# Wie JARVIS dich nennen soll (z.B. Sir, Medin, Boss)
JARVIS_USER_NAME=Sir

# Optional: Speicherort für erstellte Dateien (Standard: Dokumente\JARVIS)
# JARVIS_OUTPUT_DIR=C:\Users\DeinName\Documents\JARVIS

# Optional: Denktiefe low / medium / high (low = schnellste Antworten)
JARVIS_EFFORT=low

# --- Weboberfläche (start-web.bat) ---
# Port der Webseite (Standard 8000 -> http://localhost:8000)
# JARVIS_WEB_PORT=8000
# Nur nötig für "start-web.bat --lan" (Zugriff vom Handy im WLAN): Passwort festlegen
# JARVIS_WEB_PASSWORD=
