# Kopiere diese Datei zu ".env" (nur für den Start auf dem eigenen PC nötig).

# Pflicht: kostenloser Key von https://console.groq.com/keys -> "Create API Key"
GROQ_API_KEY=

# Wie JARVIS dich nennt
JARVIS_USER_NAME=Sir

# Passwort für die Webseite (online Pflicht, auf dem PC optional)
JARVIS_WEB_PASSWORD=

# E-Mail Weg A - Outlook/Hotmail: Anwendungs-ID (Client-ID) aus Microsoft Entra
MS_CLIENT_ID=

# E-Mail Weg B - Gmail/GMX/Web.de: Adresse + App-Passwort
MAIL_ADDRESS=
MAIL_APP_PASSWORD=
